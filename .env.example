# Where the Laravel API lives. Keep "/api" in development (Vite proxies it to VITE_BACKEND_URL).
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Laravel Reverb (live updates). Must match backend/.env
VITE_REVERB_APP_KEY=cordova-key
VITE_REVERB_HOST=
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
